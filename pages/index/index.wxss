.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 36rpx;
  background: #1890ff;
  color: #fff;
  margin-bottom: 24rpx;
}

.month-title {
  font-size: 42rpx;
  font-weight: 600;
}

.today-total {
  font-size: 34rpx;
  opacity: 0.9;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
}

.yuan-symbol {
  font-size: 56rpx;
  color: #1890ff;
  margin-right: 16rpx;
  font-weight: 600;
}

.amount-input {
  flex: 1;
  font-size: 64rpx;
  font-weight: 600;
  color: #333;
  min-height: 88rpx;
  line-height: 88rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  border-radius: 12rpx;
  background: #f5f5f5;
  transition: all 0.2s;
}

.category-item.selected {
  background: #e6f7ff;
  border: 2rpx solid #1890ff;
}

.category-emoji {
  font-size: 56rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 28rpx;
  color: #666;
}

.category-item.selected .category-name {
  color: #1890ff;
  font-weight: 500;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 36rpx;
}

.arrow {
  font-size: 44rpx;
  color: #999;
}

.remark-field {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 36rpx;
  min-height: 140rpx;
  box-sizing: border-box;
  width: 100%;
}

.remark-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.image-btn {
  width: 64rpx;
  height: 64rpx;
  background: #e6f7ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #1890ff;
}

.image-btn-icon {
  font-size: 32rpx;
}

.remark-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.remark-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.btn-primary {
  margin-top: 24rpx;
}