.month-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-label {
  font-size: 28rpx;
  color: #999;
}

.picker-value {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #333;
}

.arrow {
  font-size: 40rpx;
  color: #999;
  margin-left: 8rpx;
}

.total-card {
  background: linear-gradient(135deg, #1890ff, #3eb8ff);
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.total-label {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 12rpx;
}

.total-amount {
  font-size: 56rpx;
  font-weight: 700;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.record-list {
  margin-top: 10rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
}

.record-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-category {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-amount {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.delete-btn {
  font-size: 24rpx;
  color: #ff4d4f;
}