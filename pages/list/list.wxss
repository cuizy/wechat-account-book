.search-card {
  padding: 20rpx 24rpx;
}

.search-input {
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 20rpx 28rpx;
  font-size: 34rpx;
}

.month-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.picker-label {
  font-size: 34rpx;
  color: #999;
}
.picker-value {
  display: flex;
  align-items: center;
  font-size: 38rpx;
  color: #333;
}

.arrow {
  font-size: 44rpx;
  color: #999;
  margin-left: 8rpx;
}

.total-card {
  background: linear-gradient(135deg, #1890ff, #3eb8ff);
  border-radius: 16rpx;
  padding: 48rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.total-label {
  font-size: 34rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 14rpx;
}

.total-amount {
  font-size: 68rpx;
  font-weight: 700;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 34rpx;
}

.record-list {
  margin-top: 12rpx;
}
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: flex-start;
}
.record-emoji {
  font-size: 52rpx;
  margin-right: 24rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-category {
  font-size: 36rpx;
  color: #333;
  margin-bottom: 8rpx;
}
.record-date {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.record-remark {
  font-size: 28rpx;
  color: #666;
  margin-top: 6rpx;
}
.record-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  margin-top: 10rpx;
}
.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-amount {
  font-size: 38rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.delete-btn {
  font-size: 28rpx;
  color: #ff4d4f;
}