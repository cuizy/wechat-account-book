.stats-card {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 48rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 58rpx;
  font-weight: 700;
  color: #1890ff;
  display: block;
  margin-bottom: 14rpx;
}

.stat-label {
  font-size: 32rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 96rpx;
  background: #eee;
}