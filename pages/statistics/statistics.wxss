.total-card {
  background: linear-gradient(135deg, #1890ff, #3eb8ff);
  border-radius: 16rpx;
  padding: 48rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.total-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.total-label {
  font-size: 34rpx;
  opacity: 0.9;
  display: block;
}
.budget-btn {
  font-size: 30rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.total-amount {
  font-size: 68rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 20rpx;
}

.budget-info {
  margin-top: 12rpx;
}

.budget-bar {
  height: 14rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}
.budget-fill {
  height: 100%;
  background: #fff;
  border-radius: 7rpx;
  transition: width 0.3s;
}

.budget-fill.over {
  background: #ff4d4f;
}

.budget-text {
  font-size: 28rpx;
  opacity: 0.9;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 34rpx;
}
.stats-list {
  margin-top: 12rpx;
}
.stats-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}
.stats-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.stats-emoji {
  font-size: 48rpx;
  margin-right: 24rpx;
}
.stats-info {
  flex: 1;
  margin-right: 24rpx;
}

.stats-name {
  font-size: 34rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 14rpx;
  background: #f0f0f0;
  border-radius: 7rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff, #3eb8ff);
  border-radius: 7rpx;
  transition: width 0.3s;
}
.stats-right {
  text-align: right;
  min-width: 140rpx;
}
.stats-amount {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
  display: block;
}
.stats-percent {
  font-size: 28rpx;
  color: #999;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.export-btn {
  font-size: 32rpx;
  color: #1890ff;
  padding-right: 8rpx;
}