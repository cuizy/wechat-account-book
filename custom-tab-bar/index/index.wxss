.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: #ffffff;
  border-top: 1rpx solid #e0e0e0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.icon {
  width: 72rpx;
  height: 72rpx;
}

.label {
  font-size: 56rpx;
  color: #999999;
}

.tab-item.active .label {
  color: #1890ff;
  font-weight: 600;
}